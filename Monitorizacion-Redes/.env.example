# Copia este fichero como ".env" y ajusta los valores antes de levantar el stack:
#   cp .env.example .env
#   docker compose up -d
#
# NUNCA subas ".env" a Git (ver .gitignore): contiene credenciales reales.

# --- Imágenes Zabbix --------------------------------------------------------
# Tag de las imágenes oficiales de Zabbix (server, web y agente deben coincidir).
# "alpine-7.4-latest" sigue la rama estable 7.4 sobre Alpine (recomendado para laboratorio).
ZBX_VERSION=alpine-7.4-latest

# --- Identidad del servidor --------------------------------------------------
# Nombre con el que el agente/servidor se anuncian. DEBE coincidir exactamente
# con el nombre del host dado de alta en Data collection -> Hosts del frontend.
ZBX_HOSTNAME=zabbix-server

# Zona horaria usada por el frontend (fechas/horas mostradas en la interfaz).
ZBX_TIMEZONE=Europe/Madrid

# --- Acceso desde el navegador ------------------------------------------------
# Puerto del host donde se publicará el frontend: http://localhost:WEB_PORT
WEB_PORT=8080

# --- Base de datos (MariaDB) --------------------------------------------------
DB_NAME=zabbix
DB_USER=zabbix
DB_PASS=CAMBIA_ESTA_CLAVE
DB_ROOT_PASS=CAMBIA_ESTA_CLAVE_ROOT
